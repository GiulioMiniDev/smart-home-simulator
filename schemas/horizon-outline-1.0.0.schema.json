  "$id": "urn:smart-home-simulator:schema:horizon-outline:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One brief, one confirmed outline, any horizon length.\n\nNothing here grows with the number of days: a year and eight months differ in the event list,\nnot in the structure. The confirmed outline is also the habit ground truth the external\nauthoring path has never produced, `mining_difficulty` included.",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "documentType": {
      "const": "horizon_outline",
      "default": "horizon_outline",
      "title": "Documenttype",
      "type": "string"
    },
    "outlineId": {
      "minLength": 1,
      "title": "Outlineid",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "residentId": {
      "minLength": 1,
      "title": "Residentid",
      "type": "string"
    },
    "timeZone": {
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "startDate": {
      "format": "date",
      "title": "Startdate",
      "type": "string"
    },
    "months": {
      "minimum": 1,
      "title": "Months",
      "type": "integer"
    },
    "world": {
      "$ref": "#/$defs/OutlineWorld"
    },
    "profile": {
      "$ref": "#/$defs/BehavioralProfile"
