    "OutlineRhythm": {
      "additionalProperties": false,
      "description": "The persona-level constants the drive dynamics need, and nothing more.\n\nAge sets the nightly sleep need and the nocturia baseline; declared conditions move the same\ntwo dials. Everything downstream of these \u2014 the actual bedtimes, the debt, the naps \u2014 is\ncomputed, which is why an author declares who the resident is rather than when she sleeps.",
      "properties": {
        "age": {
          "default": 45,
          "maximum": 120,
          "minimum": 1,
          "title": "Age",
          "type": "integer"
