    "FixedCommitment": {
      "additionalProperties": false,
      "description": "The one place absolute clock times are legitimate.\n\nWorking hours and appointments are fixed by someone other than the resident, so pinning them\nis a fact about the world rather than a schedule the model invented. Everything else in this\ncontract is a window.",
      "properties": {
        "commitmentId": {
          "minLength": 1,
          "title": "Commitmentid",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "weekdays": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "minItems": 1,
          "title": "Weekdays",
          "type": "array"
        },
