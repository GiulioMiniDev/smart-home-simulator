    "OutlineEvent": {
      "additionalProperties": false,
      "description": "Something that happens a bounded number of times inside a date window.\n\nThe window is the point. `earliest_date == latest_date` pins the day when the day genuinely is\nfixed; anything wider hands the placement to the expander, which owns the calendar and the\ndrive state and can put the event where the resident could plausibly absorb it.",
      "properties": {
        "eventId": {
          "minLength": 1,
          "title": "Eventid",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "earliestDate": {
          "format": "date",
          "title": "Earliestdate",
          "type": "string"
        },
        "latestDate": {
          "format": "date",
          "title": "Latestdate",
          "type": "string"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "windowStart": {
          "default": "08:00",
          "title": "Windowstart",
          "type": "string"
        },
        "windowEnd": {
          "default": "22:00",
          "title": "Windowend",
          "type": "string"
        },
        "minimumMinutes": {
          "default": 30,
          "minimum": 1,
          "title": "Minimumminutes",
          "type": "integer"
        },
        "maximumMinutes": {
          "default": 120,
          "minimum": 1,
          "title": "Maximumminutes",
          "type": "integer"
        },
        "weekdays": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "title": "Weekdays",
          "type": "array"
        },
