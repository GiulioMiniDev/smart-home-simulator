          "title": "Intent"
        },
        "displaces": {
          "items": {
            "$ref": "#/$defs/ActivityDisplacement"
          },
          "title": "Displaces",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
