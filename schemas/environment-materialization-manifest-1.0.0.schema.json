{
  "$defs": {
    "WorkspaceArtifact": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "relativePath": {
          "minLength": 1,
          "title": "Relativepath",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "relativePath",
        "sha256"
      ],
      "title": "WorkspaceArtifact",
      "type": "object"
    }
  },
  "$id": "urn:smart-home-simulator:schema:environment-materialization-manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What materializing the environment alone produced: a plan and a sensor field, no execution.\n\nDeliberately not a `SyntheticWorkspaceManifest` with empty fields. That document asserts a\ncomplete workspace \u2014 trace and observable log included \u2014 and a home that has not been run yet\nhas neither. Claiming one with placeholder identifiers would make an unexecuted environment\nindistinguishable from a run whose evidence went missing.",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "documentType": {
      "const": "environment_materialization_manifest",
      "default": "environment_materialization_manifest",
      "title": "Documenttype",
      "type": "string"
    },
    "workflowVersion": {
      "const": "scenario-first-1.0.0",
      "default": "scenario-first-1.0.0",
      "title": "Workflowversion",
      "type": "string"
    },
    "success": {
      "const": true,
      "default": true,
      "title": "Success",
      "type": "boolean"
    },
    "executed": {
      "const": false,
      "default": false,
      "title": "Executed",
      "type": "boolean"
    },
    "scenarioId": {
      "title": "Scenarioid",
      "type": "string"
    },
    "bundleId": {
      "title": "Bundleid",
      "type": "string"
    },
    "homeId": {
      "title": "Homeid",
      "type": "string"
    },
    "sensorModelId": {
      "title": "Sensormodelid",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/WorkspaceArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "scenarioId",
    "bundleId",
    "homeId",
    "sensorModelId",
    "artifacts"
  ],
  "title": "Smart Home Environment Materialization Manifest 1.0.0",
  "type": "object"
}
